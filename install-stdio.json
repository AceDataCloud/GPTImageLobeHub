{
  "mcpServers": {
    "gpt-image-by-ace": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "https://github.com/AceDataCloud/GPTImageLobeHub/releases/download/v0.1.0/gpt_image_lobehub-0.1.0-py3-none-any.whl",
        "gpt-image-lobehub"
      ],
      "env": {
        "ACEDATACLOUD_API_TOKEN": "YOUR_API_TOKEN"
      }
    }
  }
}
